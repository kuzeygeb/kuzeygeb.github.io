---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-4 pt-6 h-auto min-h-full w-[20rem] bg-base-200/90 backdrop-blur-md text-base-content flex flex-col border-r border-base-300">
    <div class="w-fit mx-auto mt-2 mb-4 text-center">
      <a href="/" class="group block">
        <div class="avatar transition ease-in-out duration-300 group-hover:scale-105 block m-auto">
          <div class="w-[8.5rem] h-[8.5rem] rounded-full ring-4 ring-primary/80 ring-offset-base-100 ring-offset-2 overflow-hidden shadow-xl bg-base-300">
            <img 
              src="/profil fotoğrafı.jpg" 
              alt="Kuzey Çağan Gebrecioğlu" 
              class="w-full h-full object-cover"
              width="136"
              height="136"
            />
          </div>
        </div>
      </a>
      
      <div class="mt-4">
        <h1 class="text-xl font-extrabold tracking-tight text-base-content flex items-center justify-center gap-1.5">
          <span>Kuzey Çağan</span>
          <span class="text-sm" title="European Union & Youth Work">🇪🇺</span>
        </h1>
        <p class="text-xs font-bold uppercase tracking-wider text-primary mt-1">
          <span class="lang-en">IR Strategist & Developer</span>
          <span class="lang-tr hidden">Uİ Stratejisti & Geliştirici</span>
        </p>
        <p class="text-xs text-base-content/75 mt-0.5">
          <span class="lang-en">Youth Worker · Non-Formal Educator</span>
          <span class="lang-tr hidden">Gençlik Çalışanı · Yaygın Eğitim Eğitmeni</span>
        </p>
      </div>

      <!-- EU Solidarity Corps status badge -->
      <div class="mt-3.5 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="lang-en">ESC Volunteering Candidate</span>
        <span class="lang-tr hidden">ESC Gönüllülük Adayı</span>
      </div>
    </div>
    
    <div class="divider my-1 opacity-40"></div>
    
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <SideBarFooter />
  </aside>
</div>
