---
import LanguageToggle from "./LanguageToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-primary/10 font-bold text-primary border-l-4 border-primary";
---

<div class="px-2 pb-3 mb-2 flex justify-between items-center border-b border-base-300/60">
  <LanguageToggle />
  <ThemeToggle />
</div>

<ul class="menu grow shrink menu-md overflow-y-auto px-1 space-y-1 font-medium">
    <li>
      <a class="py-2.5 text-sm rounded-lg transition-colors flex items-center gap-2" id="home" href="/">
        <span>🏠</span>
        <span class="lang-en">Home</span>
        <span class="lang-tr hidden">Ana Sayfa</span>
      </a>
    </li>
    <li>
      <a class="py-2.5 text-sm rounded-lg transition-colors flex items-center gap-2" id="blog" href="/blog">
        <span>✍️</span>
        <span class="lang-en">Blog & Analyses</span>
        <span class="lang-tr hidden">Blog & Analizler</span>
      </a>
    </li>
    <li>
      <a class="py-2.5 text-sm rounded-lg transition-colors flex items-center gap-2" id="projects" href="/projects">
        <span>🇪🇺</span>
        <span class="lang-en">Projects & Fieldwork</span>
        <span class="lang-tr hidden">Projeler & Saha</span>
      </a>
    </li>
    <li>
      <a class="py-2.5 text-sm rounded-lg transition-colors flex items-center gap-2" id="gallery" href="/gallery">
        <span>📸</span>
        <span class="lang-en">Media & Gallery</span>
        <span class="lang-tr hidden">Medya & Galeri</span>
      </a>
    </li>
    <li>
      <a class="py-2.5 text-sm rounded-lg transition-colors flex items-center gap-2" id="cv" href="/cv">
        <span>📄</span>
        <span class="lang-en">Curriculum Vitae</span>
        <span class="lang-tr hidden">Özgeçmiş (CV)</span>
      </a>
    </li>
    <li class="pt-2">
        <a
            class="py-2.5 text-sm rounded-xl transition-all bg-primary text-white hover:bg-primary/90 font-semibold flex items-center justify-between shadow-sm"
            href="mailto:kuzeygebrecioglu@gmail.com"
            target="_blank"
            rel="noopener noreferrer"
        >
            <span>✉️ <span class="lang-en">Get in Touch</span><span class="lang-tr hidden">İletişime Geç</span></span>
            <span class="text-xs">↗</span>
        </a>
    </li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
if (activeItemElem) {
    activeClass.split(" ").forEach(cls => activeItemElem.classList.add(cls));
}
</script>
