---
const { title, img, desc, url, badge, tags, target } = Astro.props;
const linkTarget = target || (url && (url.startsWith('http') || url.startsWith('//')) ? '_blank' : '_self');
const linkRel = linkTarget === '_blank' ? 'noopener noreferrer' : undefined;

let initialSrc = img;
if (initialSrc && !initialSrc.startsWith('/') && !initialSrc.startsWith('http')) {
  initialSrc = '/' + initialSrc;
}
---

<div class="rounded-2xl bg-base-100 hover:shadow-lg transition-all duration-300 border border-base-300/60 overflow-hidden mb-6 group">
  <a href={url} target={linkTarget} rel={linkRel} class="block">
    <div class="hero-content flex-col md:flex-row p-5 gap-6 items-start">
      {
        initialSrc && (
          <div class="w-full md:w-5/12 max-w-[260px] h-44 rounded-xl overflow-hidden bg-base-200 border border-base-300 shrink-0">
            <img
              src={encodeURI(initialSrc)}
              data-orig={initialSrc}
              alt={title}
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
              onerror="const orig = this.getAttribute('data-orig'); if (!this.dataset.step) { this.dataset.step = '1'; this.src = encodeURI('/Fotoğraflar' + (orig.startsWith('/') ? orig : '/' + orig)); } else if (this.dataset.step === '1') { this.dataset.step = '2'; if (orig.endsWith('.jpeg')) { this.src = encodeURI(orig.replace('.jpeg', '.jpg')); } else if (orig.endsWith('.jpg')) { this.src = encodeURI(orig.replace('.jpg', '.jpeg')); } else { this.src = '/post_img.webp'; } } else { this.src = '/post_img.webp'; }"
            />
          </div>
        )
      }
      <div class="grow w-full flex flex-col justify-between min-h-[9.5rem]">
        <div>
          <div class="flex items-center gap-2 flex-wrap mb-1.5">
            <h2 class="text-lg md:text-xl font-bold text-base-content group-hover:text-primary transition-colors">
              {title}
            </h2>
            {badge && <span class="badge badge-primary badge-sm font-semibold">{badge}</span>}
          </div>
          <p class="text-sm text-base-content/80 leading-relaxed line-clamp-3 md:line-clamp-none">
            {desc}
          </p>
        </div>
        {
          tags && tags.length > 0 && (
            <div class="card-actions justify-start gap-1.5 mt-3 flex-wrap">
              {tags.map((tag) => (
                <span class="badge badge-outline badge-sm text-xs opacity-75">{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </a>
</div>
