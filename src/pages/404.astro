---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found" includeSidebar={false}>
  <div class="text-center py-20">
    <div class="text-9xl mb-4">🏝</div>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl">
      <span class="lang-en">The page you're looking for couldn't be found.</span>
      <span class="lang-tr hidden">Aradığınız sayfa bulunamadı.</span>
    </h3>
    <a class="btn btn-primary mt-9 rounded-xl" href="/">
      <span class="lang-en">Go Home</span>
      <span class="lang-tr hidden">Ana Sayfaya Dön</span>
    </a>
  </div>
</BaseLayout>
