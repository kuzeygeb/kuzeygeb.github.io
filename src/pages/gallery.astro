---

<BaseLayout title="Media & Gallery | Kuzey Çağan Gebrecioğlu" sideBarActiveItemID="gallery">
  <!-- Page Header -->
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 mb-3 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="lang-en">40+ Field Photos · Video Recording · International Project Records</span>
      <span class="lang-tr hidden">40+ Saha Görseli · Video Kayıtları · Uluslararası Proje Belgeleri</span>
    </div>
    <h1 class="text-3xl font-extrabold tracking-tight text-base-content">
      <span class="lang-en">Field Media & Project Gallery</span>
      <span class="lang-tr hidden">Saha Görselleri & Medya Galerisi</span>
    </h1>
    <p class="text-sm text-base-content/75 mt-1">
      <span class="lang-en">Visual documentation from Erasmus+ projects, diplomatic translation missions, Let's Do It! workshops, and European Parliament visits</span>
      <span class="lang-tr hidden">Erasmus+ projeleri, diplomatik çevirmenlikler, Let's Do It! Türkiye atölyeleri ve Avrupa Parlamentosu ziyaretleri</span>
    </p>
  </div>

  <!-- Featured Video Section -->
  <div class="card bg-gradient-to-br from-primary/10 via-base-200 to-base-300 border-2 border-primary/40 rounded-2xl overflow-hidden shadow-lg mb-10">
    <div class="p-6">
      <div class="flex items-center gap-2 mb-3">
        <span class="badge badge-primary font-bold">
          <span class="lang-en">Featured Video</span>
          <span class="lang-tr hidden">Öne Çıkan Video Kaydı</span>
        </span>
        <span class="text-xs text-base-content/70 font-semibold">
          <span class="lang-en">Diplomatic Translation</span>
          <span class="lang-tr hidden">Diplomatik Çevirmenlik</span>
        </span>
      </div>
      <h2 class="text-2xl font-bold text-base-content mb-2">
        <span class="lang-en">Diplomatic Consecutive Translation for Estonian Ambassador H.E. Väino Reinart</span>
        <span class="lang-tr hidden">Estonya Büyükelçisi H.E. Väino Reinart Resepsiyon Çevirmenliği</span>
      </h2>
      <p class="text-sm text-base-content/85 leading-relaxed mb-5 max-w-3xl lang-en">
        Live video recording of consecutive translation and diplomatic liaison support provided during the official reception proceedings for H.E. Väino Reinart, Ambassador of the Republic of Estonia to Turkey.
      </p>
      <p class="text-sm text-base-content/85 leading-relaxed mb-5 max-w-3xl lang-tr hidden">
        Estonya Cumhuriyeti Türkiye Büyükelçisi Väino Reinart'ın katıldığı resmi resepsiyon toplantısında gerçekleştirilen canlı ardıl çevirmenlik ve diplomatik eşlik görevine ait video kaydı.
      </p>

      <div class="w-full max-w-3xl mx-auto rounded-xl overflow-hidden border border-base-300 shadow-md bg-black">
        <video 
          controls 
          preload="metadata"
          poster={encodeURI("/Estonya Büyükelçisi Väino Reinart resepsiyonunda.jpg")}
          class="w-full max-h-[450px] object-contain"
        >
          <source src={encodeURI("/estonya büyükelçisi Väino Reinart_ın çevirmenliğini yaptığımda.mp4")} type="video/mp4" />
          Browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </div>

  <!-- Filter Buttons -->
  <div class="flex flex-wrap gap-2 mb-8" id="filter-buttons">
    <button data-filter="all" class="filter-btn btn btn-sm btn-primary rounded-xl" aria-pressed="true">
      <span class="lang-en">All Media</span>
      <span class="lang-tr hidden">Tüm Medyalar</span>
    </button>
    <button data-filter="erasmus" class="filter-btn btn btn-sm btn-outline rounded-xl" aria-pressed="false">🇪🇺 EU & Erasmus+</button>
    <button data-filter="diplomacy" class="filter-btn btn btn-sm btn-outline rounded-xl" aria-pressed="false">🏛️ Diplomacy</button>
    <button data-filter="sustainability" class="filter-btn btn btn-sm btn-outline rounded-xl" aria-pressed="false">🌱 Sustainability</button>
    <button data-filter="outreach" class="filter-btn btn btn-sm btn-outline rounded-xl" aria-pressed="false">🎓 Workshops</button>
  </div>

  <!-- Media Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="gallery-grid">
    {mediaItems.map((item) => (
      <div 
        class="gallery-card card bg-base-200/60 hover:bg-base-200 border border-base-300 hover:border-primary/50 transition-all duration-300 rounded-2xl overflow-hidden shadow-sm hover:shadow-md group cursor-pointer"
        data-category={item.category}
        data-src={item.src}
        data-title={item.title}
        data-desc={item.desc}
        data-title-tr={item.title_tr}
        data-desc-tr={item.desc_tr}
        data-type={item.type}
      >
        <figure class="relative h-48 overflow-hidden bg-base-300">
          <img 
            src={encodeURI(item.type === 'video' ? (item.poster || item.src) : item.src)} 
            alt={item.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
          <div class="absolute top-3 left-3">
            <span class="badge badge-primary badge-sm font-semibold shadow-sm">{item.badge}</span>
          </div>
          {item.type === 'video' && (
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
              <div class="w-12 h-12 rounded-full bg-primary/90 text-white flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                ▶
              </div>
            </div>
          )}
        </figure>
        <div class="p-4">
          <h3 class="font-bold text-base text-base-content group-hover:text-primary transition-colors line-clamp-1 mb-1">
            <span class="lang-en">{item.title}</span>
            <span class="lang-tr hidden">{item.title_tr || item.title}</span>
          </h3>
          <p class="text-xs text-base-content/75 line-clamp-2 leading-relaxed">
            <span class="lang-en">{item.desc}</span>
            <span class="lang-tr hidden">{item.desc_tr || item.desc}</span>
          </p>
        </div>
      </div>
    ))}
  </div>

  <!-- Lightbox Modal -->
  <dialog id="media_modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-4xl bg-base-100 border border-base-300 rounded-2xl p-6">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3">✕</button>
      </form>
      <div id="modal-content" class="mt-2">
        <div id="modal-media-container" class="w-full max-h-[65vh] flex items-center justify-center rounded-xl overflow-hidden bg-black mb-4">
        </div>
        <h3 id="modal-title" class="font-bold text-xl text-base-content mb-2"></h3>
        <p id="modal-desc" class="text-sm text-base-content/85 leading-relaxed"></p>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <!-- Interactive Filtering Script -->
  <script>
    function initGallery() {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.gallery-card');
      const modal = document.getElementById('media_modal') as HTMLDialogElement;
      const modalContainer = document.getElementById('modal-media-container');
      const modalTitle = document.getElementById('modal-title');
      const modalDesc = document.getElementById('modal-desc');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          
          filterBtns.forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-outline');
          });
          btn.classList.remove('btn-outline');
          btn.classList.add('btn-primary');
          filterBtns.forEach(b => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');

          cards.forEach(card => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              (card as HTMLElement).style.display = 'flex';
            } else {
              (card as HTMLElement).style.display = 'none';
            }
          });
        });
      });

      cards.forEach(card => {
        card.addEventListener('click', () => {
          const src = card.getAttribute('data-src');
          const title = card.getAttribute('data-title');
          const desc = card.getAttribute('data-desc');
          const type = card.getAttribute('data-type');

          const title_tr = card.getAttribute('data-title-tr');
          const desc_tr = card.getAttribute('data-desc-tr');
          if (modalTitle) modalTitle.innerHTML = `<span class="lang-en">${title || ''}</span><span class="lang-tr hidden">${title_tr || title || ''}</span>`;
          if (modalDesc) modalDesc.innerHTML = `<span class="lang-en">${desc || ''}</span><span class="lang-tr hidden">${desc_tr || desc || ''}</span>`;

          const currentLang = localStorage.getItem('site_lang') || 'en';
          if (currentLang === 'tr') {
            modalTitle?.querySelectorAll('.lang-en').forEach(el => el.classList.add('hidden'));
            modalTitle?.querySelectorAll('.lang-tr').forEach(el => el.classList.remove('hidden'));
            modalDesc?.querySelectorAll('.lang-en').forEach(el => el.classList.add('hidden'));
            modalDesc?.querySelectorAll('.lang-tr').forEach(el => el.classList.remove('hidden'));
          } else {
            modalTitle?.querySelectorAll('.lang-tr').forEach(el => el.classList.add('hidden'));
            modalTitle?.querySelectorAll('.lang-en').forEach(el => el.classList.remove('hidden'));
            modalDesc?.querySelectorAll('.lang-tr').forEach(el => el.classList.add('hidden'));
            modalDesc?.querySelectorAll('.lang-en').forEach(el => el.classList.remove('hidden'));
          }

          if (modalContainer) {
            if (type === 'video') {
              modalContainer.innerHTML = `<video controls autoplay class="w-full max-h-[60vh] object-contain"><source src="${src}" type="video/mp4" /></video>`;
            } else {
              modalContainer.innerHTML = `<img src="${src}" alt="${title}" class="w-full max-h-[60vh] object-contain" />`;
            }
          }

          if (modal) modal.showModal();
          modal.setAttribute('data-current-src', src);
        });
      });

      // Keyboard navigation for lightbox
      document.addEventListener('keydown', (e) => {
        const modal = document.getElementById('media_modal') as HTMLDialogElement;
        if (!modal || !modal.open) return;
        
        const visibleCards = Array.from(document.querySelectorAll('.gallery-card')).filter(
          card => (card as HTMLElement).style.display !== 'none'
        );
        
        if (visibleCards.length === 0) return;
        
        const currentSrc = modal.getAttribute('data-current-src');
        const currentIndex = visibleCards.findIndex(
          card => card.getAttribute('data-src') === currentSrc
        );
        
        let nextIndex = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (currentIndex + 1) % visibleCards.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (currentIndex - 1 + visibleCards.length) % visibleCards.length;
        }
        
        if (nextIndex >= 0) {
          const nextCard = visibleCards[nextIndex] as HTMLElement;
          nextCard.click();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initGallery);
    } else {
      initGallery();
    }
    document.addEventListener('astro:page-load', initGallery);
  </script>
</BaseLayout>
